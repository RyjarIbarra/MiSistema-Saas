<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="producto_detalle" language="java" pageWidth="842" pageHeight="595"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="b0000000-0000-0000-0000-000000000000">

    <parameter name="filtroTexto" forPrompting="false" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="filtroActivo" forPrompting="false" class="java.lang.Boolean">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <field name="proid" class="java.lang.Long"/>
    <field name="gtin" class="java.lang.String"/>
    <field name="prodesc" class="java.lang.String"/>
    <field name="tipoProducto" class="java.lang.String"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="familia" class="java.lang.String"/>
    <field name="marca" class="java.lang.String"/>
    <field name="ubicacion" class="java.lang.String"/>
    <field name="tasaIva" class="java.lang.Double"/>
    <field name="ctrlstock" class="java.lang.Boolean"/>
    <field name="activo" class="java.lang.Boolean"/>
    <field name="proobs" class="java.lang.String"/>

    <title height="60">
        <element kind="staticText" uuid="b0000000-0000-0000-0000-000000000001"
                 x="0" y="0" width="802" height="30" fontSize="18.0" bold="true" hTextAlign="Center">
            <text><![CDATA[Listado Detallado de Productos]]></text>
        </element>
        <element kind="textField" uuid="b0000000-0000-0000-0000-000000000002"
                 x="0" y="35" width="802" height="15" fontSize="9.0" italic="true"
                 blankWhenNull="true" hTextAlign="Center">
            <expression><![CDATA[
                "Filtros:" +
                ($P{filtroTexto} == null || $P{filtroTexto}.isEmpty() ? " (sin busqueda)" : " busqueda='" + $P{filtroTexto} + "'") +
                " | Activo=" + ($P{filtroActivo} == null ? "todos" : ($P{filtroActivo} ? "solo activos" : "solo inactivos"))
            ]]></expression>
        </element>
    </title>

    <columnHeader height="22">
